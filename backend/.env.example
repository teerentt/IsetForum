# Exemple uniquement : renseigner ces variables dans le terminal ou l’IDE.
# Spring Boot ne charge pas automatiquement ce fichier.
DB_URL=jdbc:mysql://localhost:3306/isetForum?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=
FRONTEND_URL=http://localhost:4200
# Profil dev : Mailpit, sans authentification ni STARTTLS.
DEV_SMTP_HOST=localhost
DEV_SMTP_PORT=1025
# Hors profil dev : fournisseur SMTP de production.
MAIL_FROM=noreply@votre-domaine.tn
SMTP_HOST=smtp.votre-fournisseur.tn
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
PDF_MAX_BYTES=5242880
# Choisir avant la première création de l’administrateur en profil dev.
DEV_SEED_PASSWORD=IsetForumDev!2026
